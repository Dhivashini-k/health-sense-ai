# Copy this file to .env and fill in your own values

# Use SQLite for quick local development, or point to a real Postgres instance:
# DATABASE_URL=postgresql://healthsense:healthsense@localhost:5432/healthsense
DATABASE_URL=sqlite:///./healthsense.db

JWT_SECRET=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173

# Optional: enables the HealthHero AI assistant (floating chatbot).
# Without this key set, the assistant responds with a friendly fallback message.
ANTHROPIC_API_KEY=
